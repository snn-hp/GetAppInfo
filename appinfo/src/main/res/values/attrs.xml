<?xml version="1.0" encoding="utf-8"?>
<resources>
    <attr name="radius" format="reference|dimension" />

    <declare-styleable name="RoundImageView">
        <attr name="radius" />
    </declare-styleable>

    <declare-styleable name="DraggableFrameLayout">
        <attr name="showPercent" format="float" />
        <attr name="direction">
            <enum name="none" value="0" />
            <enum name="left" value="1" />
            <enum name="right" value="2" />
            <enum name="all" value="3" />
        </attr>

    </declare-styleable>

    <attr name="position">
        <enum name="left_top" value="0" />
        <enum name="right_top" value="1" />
        <enum name="left_bottom" value="2" />
        <enum name="right_bottom" value="3" />
    </attr>
    <declare-styleable name="ArcMenu">
        <attr name="position" />
        <attr name="radius" />
        <!-- 主按钮额外 margin -->
        <attr name="mainBtnMarginLeft" format="dimension" />
        <attr name="mainBtnMarginTop" format="dimension" />
        <attr name="mainBtnMarginRight" format="dimension" />
        <attr name="mainBtnMarginBottom" format="dimension" />
        <attr name="startAngle" format="integer" />
        <attr name="endAngle" format="integer" />
    </declare-styleable>

</resources>